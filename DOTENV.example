# SDP360 — environment template. Copy to .env and fill in. NEVER commit .env.
# (reports-db.js names this file in its first-boot error message.)

# ── Server ──────────────────────────────────────────────────────────
PORT=3456
BIND_HOST=0.0.0.0
NODE_ENV=production
CACHE_TTL=300
# CORS_EXTRA_ORIGINS=https://sharepoint.example.com
# SESSION_COOKIE_SECURE=1

# ── Bootstrap admin (first boot only; min 12 chars) ─────────────────
DASH_USER=admin
DASH_PASS=change-me-please-12

# ── Zoho Analytics Plus (SDP mirror) — can also be set in Admin ▸ API Integration ──
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
WORKSPACE_ID=
ORG_ID=

# ── Storage: PostgreSQL is the ONLY database (PO-08, 2026-10-28 — SQLite removed) ──
# The server refuses to start without PG_URL (services/backendGuard.js). The old
# *_BACKEND variables are ignored. Offline field capture runs in the browser (service
# worker + local queue); there is no server-side SQLite at all.
PG_URL=postgres://sdp_app:<PG_PASSWORD>@localhost:5432/sdp_dashboard
# SDP_DATA_DIR=./data

# ── Secrets-at-rest key for report_config (AES-256-GCM). Required in prod. ──
# SDP_CONFIG_KEY=<32+ random chars>
# ── Backup-at-rest key (E11): the nightly pg_dump is gzip + AES-256-GCM with THIS key
#    (*.sql.gz.enc). DISTINCT from SDP_CONFIG_KEY; >= 16 chars; keep it in the vault with .env.
#    Absent → plaintext *.sql.gz and a warning line on every backup run (never silent).
# SDP_BACKUP_KEY=<16+ random chars, different from SDP_CONFIG_KEY>
# SDP_BACKUP_DIR=./data/backups
# SDP_BACKUP_KEEP=14

# ── Optional integrations ───────────────────────────────────────────
# DASHBOARD_API_KEY=
# FMP_API_KEY=
# EXEC_PPTX_TIMEOUT_MS=120000
# REPORT_SEND_TIMEOUT_MS=120000

# ── Step 4 — security (2026-10-19) ─────────────────────────────────────────────
# NODE_ENV=production makes SDP_CONFIG_KEY MANDATORY (the server refuses to start without it);
# SDP_ALLOW_PLAINTEXT_SECRETS=1 is the logged escape hatch for a migration window only.
# NODE_ENV=production
# SDP_ALLOW_PLAINTEXT_SECRETS=0
# Session lifetime in hours (default 24; the committee's recommended value is 8).
# SESSION_HOURS=8
# Entra group → role/site provisioning, JSON (also editable as config key sso_group_map):
# SSO_GROUP_MAP=[{"group":"<entra-group-object-id>","roles":["editor","tracker-editor"],"site_id":3}]
# System Logs retention in months (risk events are kept twice as long).
# AUDIT_RETENTION_MONTHS=12
