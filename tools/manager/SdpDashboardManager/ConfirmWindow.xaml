<Window x:Class="Sdp.Manager.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="White" ShowInTaskbar="False">
  <Grid Margin="22">
    <StackPanel>
      <Border Background="#FDECEC" BorderBrush="#B91C1C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#7F1D1D" FontSize="13"/>
      </Border>
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
        <Run Text="Type exactly "/><Run x:Name="PhraseRun" FontWeight="Bold" FontFamily="Consolas"/><Run Text=" to continue:"/>
      </TextBlock>
      <TextBox x:Name="Typed" FontFamily="Consolas" FontSize="14" Padding="6" TextChanged="OnTyped" AutomationProperties.Name="Confirmation phrase"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Cancel" Style="{StaticResource Btn}" IsCancel="True" Click="OnCancel"/>
        <Button x:Name="Go" Content="Continue" Style="{StaticResource Danger}" IsEnabled="False" Click="OnGo"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
