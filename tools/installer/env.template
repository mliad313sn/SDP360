# =====================================================================
# SDP Dashboard .env template - consumed by the Install-SDP.ps1
# questionnaire (step 4b / menu option E). KEEP PURE ASCII.
#
# Block format (the '##' directive line drives the prompt):
#   ## KEY | default=<v> | ask=text|secret | optional=1 | validate=minlen:N
#          | computed=<slot> | where=<how to find this value>
#   KEY=<default or __ASK__ or __COMPUTED__>
#
# __ASK__ left in a written .env means "placeholder, not configured yet" -
# the E option re-asks ONLY those. Unknown keys already present in a real
# .env are always preserved untouched.
# =====================================================================

## PORT | default=3456 | where=Application HTTP port (IIS proxies 443 -> this)
PORT=3456

## CACHE_TTL | default=300 | where=Analytics cache seconds (300 = 5 min)
CACHE_TTL=300

## NODE_ENV | default=production
NODE_ENV=production

## DASH_USER | default=admin | where=Dashboard bootstrap admin username
DASH_USER=admin

## DASH_PASS | ask=secret | validate=minlen:12 | where=Choose the dashboard admin password (min 12 chars - the server refuses to start below that)
DASH_PASS=__ASK__

## DASHBOARD_API_KEY | computed=api_key | validate=minlen:32 | where=Server-to-server API key (min 32 chars - the server refuses to start in production without it). Generated by the installer; Enter keeps the generated value
DASHBOARD_API_KEY=__COMPUTED__

## ZOHO_CLIENT_ID | ask=text | optional=1 | where=https://api-console.zoho.com > Self Client > Client Secret tab. Full runbook: RENEW_ZOHO_TOKEN.html (shipped with the app)
ZOHO_CLIENT_ID=__ASK__

## ZOHO_CLIENT_SECRET | ask=secret | optional=1 | where=Same Self Client page as ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=__ASK__

## ZOHO_REFRESH_TOKEN | ask=secret | optional=1 | where=Produced by the token exchange (get-token.js) - see RENEW_ZOHO_TOKEN.html step 6
ZOHO_REFRESH_TOKEN=__ASK__

## PG_URL | computed=pg_url | where=Built automatically from the sdp_app password chosen during PostgreSQL provisioning (step 4)
PG_URL=__COMPUTED__

## TRACKER_BACKEND | default=postgres | where=sqlite or postgres (fresh installs run PostgreSQL)
TRACKER_BACKEND=postgres

## MEETINGS_BACKEND | default=postgres
MEETINGS_BACKEND=postgres

## INSPECTION_BACKEND | default=postgres
INSPECTION_BACKEND=postgres

## REPORTS_BACKEND | default=postgres
REPORTS_BACKEND=postgres
