<Project Sdk="Microsoft.NET.Sdk">
  <!-- SDP Dashboard Windows service host. .NET Framework 4.8 is part of Windows Server 2016+ and
       Windows 10/11, so the service needs no runtime to be installed. Built by
       tools/installer-v2/build.ps1 (CI, windows-latest). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SdpDashboardService</AssemblyName>
    <RootNamespace>Sdp.Service</RootNamespace>
    <Company>Endeavour Mining - Group IT</Company>
    <Product>SDP Dashboard</Product>
    <Description>Runs the SDP Dashboard (Node.js) as a Windows service</Description>
    <Version>2.0.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET Framework 4.8 reference assemblies from NuGet: the build does not depend on a targeting pack
         being installed on the build machine. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
