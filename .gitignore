# ── SECRETS — NEVER COMMIT ────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
.token_cache.json

# ── RUNTIME DATA ─────────────────────────────────────────────────
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# ── NODE ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log

# ── OS / EDITOR LOCK FILES ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.~lock.*#

# ── GENERATED BINARIES — do not store in git ─────────────────────
# (regenerate these from the server at any time)
*.pptx
*.pptx.tmp
*.pdf
*.docx
*.xlsx
*.zip
*.png
*.jpg
*.jpeg
*.gif

# ── EXCEPTION: ship the IT Activity Tracker brand assets ─────────
# These are the icons embedded in tracker PPTX slides (logo, pillar icons,
# RAG check/warn marks, header chart icon, brand footer bands). They MUST
# be tracked in git so the executive-report.html PPTX export can fetch
# them client-side.
!public/tracker-icons/*.png

# ── EXCEPTION: official EDV brand assets used by the unified shell ───
# The shell logo and login-page badge load from public/brand/. These
# files come from the EDV brand-guidelines folder (logo HIGH WHITE.png
# for dark headers, logo HIGH.png for light surfaces). They have to be
# tracked so first-deploy renders correctly.
!public/brand/*.png
!public/brand/*.jpg
!public/brand/*.svg

# ── TEMP / SCRATCH FILES ─────────────────────────────────────────
*.tmp
dist/
