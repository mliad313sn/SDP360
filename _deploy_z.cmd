@echo off
rem ===========================================================================
rem  SDP-Dashboard — robust deploy to prod over the Z: SMB share.
rem
rem  What it does:
rem    1. Force-refreshes the Z: mapping (handles the stale/disconnected-handle
rem       case where a plain "if not exist Z:\" wrongly passes).
rem    2. Pre-creates the NEW subfolders on prod (routes\ services\ tools\) so
rem       xcopy never stops to ask "file or directory?" on a missing dir.
rem    3. Runs the auto-generated _deploy.cmd (the always-current file list the
rem       git post-commit hook regenerates on every commit).
rem    4. Prints the exact PM2 commands to run ON THE PROD SERVER afterwards.
rem
rem  Run from the worktree root in a normal (non-admin) cmd.exe:
rem      _deploy_z.cmd
rem  Then do the PM2 step on the production host yourself.
rem ===========================================================================
setlocal
set "SHARE=\\10.225.99.173\SDP-Dashboard"

echo ============================================================
echo  SDP-Dashboard deploy  -^>  %SHARE%  (Z:)
echo ============================================================
echo.

echo [1/4] Refreshing Z: mapping ...
net use Z: /delete /y >nul 2>&1
net use Z: "%SHARE%" /persistent:yes >nul 2>&1
if not exist "Z:\" (
  echo   retrying ...
  net use Z: "%SHARE%" /persistent:yes
)
if not exist "Z:\" (
  echo.
  echo   ERROR: cannot reach %SHARE%.
  echo     - Is the VPN up / server 10.225.99.173 reachable?
  echo     - Map manually:  net use Z: %SHARE% /persistent:yes
  echo.
  exit /b 1
)
echo   Z: connected.
echo.

echo [2/4] Ensuring new prod subfolders exist ...
if not exist "Z:\routes\"   md "Z:\routes"
if not exist "Z:\services\" md "Z:\services"
if not exist "Z:\tools\"    md "Z:\tools"
echo   routes\ services\ tools\ ready.
echo.

echo [3/4] Copying changed files (via _deploy.cmd) ...
if not exist "_deploy.cmd" (
  echo   ERROR: _deploy.cmd not found in this folder.
  echo   It is regenerated by the git post-commit hook — make a commit, then
  echo   re-run this script from the worktree root.
  exit /b 1
)
call "_deploy.cmd"
if errorlevel 1 (
  echo.
  echo   ERROR: file copy reported a failure. Review the output above.
  exit /b 1
)
echo.

echo [4/4] Files are on Z:.  NOW run this ON THE PROD SERVER (not here):
echo.
echo     pm2 stop endeavour-dashboard
echo     timeout /t 5
echo     pm2 start endeavour-dashboard
echo     pm2 save
echo.
echo   server.js + cached HTML changed this round, so a full stop/start is
echo   safer than "pm2 reload" (avoids the EADDRINUSE crash-loop documented
echo   in CLAUDE.md). "pm2 save" persists the process list for reboot.
echo.
echo   First time only: confirm the prod process can WRITE to data\blobs\
echo   (inspection photos/signatures now live there). It is auto-created on
echo   the first inspection save.
echo.
endlocal
