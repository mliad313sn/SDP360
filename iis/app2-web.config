<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse-proxy web.config for the SECOND site (app on localhost:3000).
  Drop this in the NEW IIS site's root folder.

  Architecture (mirrors the main dashboard site):
        Browser
           |  https://app2.edv-ops.com   (443, TLS — replace with the real subdomain)
           v
        IIS (same host as the dashboard)
           - new IIS site, bound to the app2 FQDN on 443
           - TLS cert: wildcard *.edv-ops.com (covers any *.edv-ops.com host)
           - this web.config in the site root
           |  http://127.0.0.1:3000      (loopback only)
           v
        Node/app on port 3000 (bind to 127.0.0.1 so it can't be hit directly)

  PREREQUISITES — already satisfied on this host by the dashboard setup,
  so NOTHING extra to run for these:
    - ARR module installed + "Enable proxy" ticked (server-level, one-time)
    - allowedServerVariables HTTP_X_FORWARDED_PROTO/HOST/FOR registered at
      apphost level (done for the dashboard — shared across all sites)

  The subdomain itself is NOT configured here — it's set via:
    1. DNS A-record  app2.edv-ops.com -> this server's IP
    2. IIS site binding (https, host = app2.edv-ops.com, port 443, the cert)
  See the checklist handed over with this file.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="ReverseProxyToApp2" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST"  value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR"   value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <!-- X-Frame-Options: DENY blocks this site from being embedded in an
             iframe. KEEP it unless app2 must be embedded somewhere (e.g. a
             SharePoint page) — in that case remove this line and instead set
             a Content-Security-Policy frame-ancestors on the trusted host. -->
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- 50 MB default. Raise only if app2 accepts large uploads. -->
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Enable WebSocket forwarding in case app2 uses live updates / SSE. -->
    <webSocket enabled="true" />

  </system.webServer>
</configuration>
