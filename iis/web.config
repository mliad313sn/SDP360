<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse-proxy configuration for the Endeavour Mining IT Dashboard.

  Purpose: terminate TLS at IIS, proxy requests to the Node application
  running on http://localhost:3456 (PM2-managed). This is the security-
  finding fix raised by Cezar (NGANSOP NGUEPKAP) in the Nov 2025 town
  hall: the app must be served over HTTPS via a corporate-DNS hostname,
  never via raw HTTP at the host's IP.

  Architecture
  ============
        Browser
           |
           | https://itops-dashboard.edv-ops.com    (port 443, TLS)
           v
        IIS (ABJ-SRV-012)
           - terminates TLS with cert from internal CA
           - bound to the FQDN above on port 443
           - this web.config lives in the IIS site root
           |
           | http://127.0.0.1:3456                  (loopback only)
           v
        Node.js / Express (PM2-managed)
           - bound to 127.0.0.1 via BIND_HOST=127.0.0.1 env var
           - external machines CANNOT hit :3456 directly
           - `app.set('trust proxy', 'loopback')` honours X-Forwarded-*

  Prerequisites on the IIS host (one-time setup; see
  docs/INTERNAL_TLS_SETUP.md for the full runbook):
    1. Install URL Rewrite module      (download from Microsoft)
    2. Install Application Request Routing (ARR) module
    3. Enable proxy in ARR:
         IIS Manager > server node > Application Request Routing Cache >
         Server Proxy Settings > tick "Enable proxy"
    4. Create an IIS site bound to the corporate hostname + port 443
    5. Bind the SSL/TLS cert issued by the internal CA
    6. Drop this web.config in the site's root folder
    7. Set BIND_HOST=127.0.0.1 in the PM2 ecosystem config and restart
       the dashboard so Node stops accepting external connections
-->
<configuration>
  <system.webServer>

    <!-- ════════════════════════════════════════════════════════════════
         URL REWRITE — proxy everything to the Node app on localhost
         ════════════════════════════════════════════════════════════════
         Catches every URL and forwards to http://localhost:3456 with the
         original path/query intact. Sets X-Forwarded-* headers so the
         Node app knows the request was originally HTTPS and what hostname
         the browser asked for.

         The rule is `stopProcessing="true"` so no later rules fire. -->
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3456/{R:1}" />
          <serverVariables>
            <!-- Tell Node: the original request was HTTPS, regardless of
                 the loopback hop being plain HTTP. Express's
                 `trust proxy: loopback` setting reads this and sets
                 req.protocol/req.secure correctly. -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST"  value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR"   value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>
      </rules>

      <!-- NOTE: server variables HTTP_X_FORWARDED_PROTO / HOST / FOR must be
           registered at the SERVER level in applicationHost.config — NOT here
           — otherwise IIS returns 500.19 "config locked at parent level".
           Run once on the prod server (cmd.exe as admin):
               cd /d %windir%\system32\inetsrv
               appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost
               appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_HOST']"  /commit:apphost
               appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_FOR']"   /commit:apphost
           Verify:
               appcmd list config -section:system.webServer/rewrite/allowedServerVariables
      -->

      <!-- ════════════════════════════════════════════════════════════════
           ARR PROXY TIMEOUT — bump from default 30s to 5 min
           ════════════════════════════════════════════════════════════════
           The PPTX export route (/api/reports/exec-pptx) spawns Python with
           matplotlib to regenerate 8 chart PNGs + python-pptx to repack the
           template, which routinely takes 45-90 seconds on production
           hardware. The default ARR proxy timeout fires before Python
           finishes, returning 502 "Web server received an invalid response"
           to the browser even though Node is still working.

           The proxy timeout lives in applicationHost.config (server-level,
           NOT this web.config). Run once on the prod server, cmd.exe as
           admin:

               cd /d %windir%\system32\inetsrv
               appcmd set config -section:system.webServer/proxy /timeout:00:05:00 /commit:apphost
               iisreset

           Verify:
               appcmd list config -section:system.webServer/proxy

           Node-side timeout is set to 4 min via EXEC_PPTX_TIMEOUT_MS in
           .env — fires BEFORE ARR's 5 min so the user gets a proper 504
           with a useful error message rather than IIS's opaque 502.
      -->
    </rewrite>

    <!-- ════════════════════════════════════════════════════════════════
         RESPONSE HEADERS — security hardening
         ════════════════════════════════════════════════════════════════
         These are belt-and-braces: the Node app sets HSTS too. If IIS is
         ever the only one in the chain (e.g. someone tests by hitting
         IIS with a static page), the security headers are still there.
    -->
    <httpProtocol>
      <customHeaders>
        <!-- HSTS: 1-year expiry, applies to subdomains. Tells every
             modern browser to refuse plain HTTP for this hostname for
             a full year after the first visit. Internal-only domain so
             we deliberately do NOT add `preload` (preload only matters
             for public hostnames in the Chrome HSTS preload list). -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <!-- Block clickjacking by refusing to be framed. The dashboard
             is never embedded anywhere; this protects against malicious
             intranet sites trying to iframe the login page. -->
        <add name="X-Frame-Options" value="DENY" />

        <!-- Disable the legacy XSS auditor (modern browsers ignore but
             it doesn't hurt) and lock content-type sniffing. -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- Limit the Referer header so we don't leak the dashboard
             URL to any external site users navigate to from a link. -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />

        <!-- Remove the default IIS server signature so version info
             isn't exposed in response headers. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- ════════════════════════════════════════════════════════════════
         REQUEST FILTERING — defense in depth
         ════════════════════════════════════════════════════════════════
         Block obvious probe traffic at the proxy before it ever reaches
         Node. Most of these are mitigated by Node anyway, but it's
         cheaper to refuse them at IIS. -->
    <security>
      <requestFiltering>
        <!-- 150 MB cap. Must be >= the largest /api/inspection/save body
             a field user can produce — heavily-documented inspections
             (60-80% of the 173 items addressed with 1-3 photos each at
             ~500 KB base64 per photo, plus 2 signatures) routinely
             land in the 60-80 MB range. Mobile users on flaky links
             cannot complete a Submit if IIS rejects the body, even
             though Node's matching limit on /api/inspection/save is
             100 MB (server.js → inspectionJsonBody).

             Was 52428800 (50 MB) — that surfaced as HTTP 413 toasts on
             the inspection form for inspectors with thorough photo
             documentation. Discovered 2026-05-25 during field use at
             Houndé. Bumped to 157286400 (150 MB) for headroom; Node-side
             body limit is the secondary check at 100 MB.

             Longer-term: chunk photos onto a dedicated
             /api/inspection/:id/photo endpoint so the state-blob save
             payload stays small (separate change, larger refactor). -->
        <requestLimits maxAllowedContentLength="157286400" />

        <!-- Hide common probe URLs that scanners hammer (.env, .git,
             .htaccess, etc.). Node would 404 these but logging them
             at IIS keeps Node's logs cleaner. -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- WebSocket forwarding — the dashboard does not currently use
         WebSockets, but enable here so future server-sent events /
         live-update features work without re-configuring IIS. -->
    <webSocket enabled="true" />

  </system.webServer>
</configuration>
