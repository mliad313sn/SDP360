{
  "name": "sdp360",
  "version": "2.0.0-alpha.14",
  "description": "SDP360 — IT Operations Management & Field Reporting Platform (ServiceDesk Plus unified ops hub). Fork of samaziz679/SDP-Dashboard v1.11.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node tools/build/build-frontend.js",
    "build:check": "node tools/build/build-frontend.js --check",
    "dev": "nodemon server.js",
    "test": "node --test --test-force-exit tests/*.test.js",
    "test:unit": "node --test --test-force-exit tests/*.test.js --test-name-pattern \"^(?!.*smoke)\"",
    "test:sdp360": "node --test --test-force-exit tests/sync-*.test.js tests/kpi-rag.test.js tests/tracker-definitions.test.js tests/dashboard-widgets.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.22.0",
    "pptxgenjs": "^3.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
